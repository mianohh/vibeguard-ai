{
  "name": "vibeguard-ai",
  "version": "1.0.0",
  "description": "Eliminate blind signing on Sui blockchain - Pre-transaction security layer",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:nautilus": "bash scripts/test-nautilus-local.sh",
    "test:rust": "cargo test --manifest-path src/nautilus-server/Cargo.toml",
    "test:blob-health": "curl http://localhost:3000/api/blob-health",
    "register:pcrs-prod": "bash scripts/register-pcrs-production.sh",
    "enclave:build": "cd src/nautilus-server && cargo build --release",
    "enclave:run": "cd src/nautilus-server && cargo run --release",
    "deploy:oracle": "bash scripts/deploy-nautilus-oracle.sh"
  },
  "dependencies": {
    "@mysten/sui": "^1.45.2",
    "@noble/ed25519": "^2.3.0",
    "@vercel/functions": "^3.4.4",
    "lucide-react": "^1.61.0",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@mysten/seal": "^0.1.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
