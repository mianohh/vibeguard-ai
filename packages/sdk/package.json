  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mianohh/vibeguard-ai.git",
    "directory": "packages/sdk"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
