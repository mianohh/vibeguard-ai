{
  "name": "vibeguard-sui-security",
  "version": "0.2.0",
  "description": "TypeScript SDK for VibeGuard AI transaction security analysis",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
