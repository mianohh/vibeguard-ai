# API Keys
API_KEYS=your_api_keys_here
NEXT_PUBLIC_API_KEY=your_api_keys_here

# Redis — shared queue for PTB batching across Vercel instances
REDIS_URL=redis://default:<password>@<host>:<port>

# zkLogin Configuration (for community threat reporting)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Sui Testnet Contract Addresses
NEXT_PUBLIC_PACKAGE_ID=your_reputation_registry_package_id_here
NEXT_PUBLIC_REGISTRY_ID=your_reputation_registry_object_id_here

# SealEnclave Contract (Nautilus Verified Compute)
SEAL_ENCLAVE_PACKAGE_ID=your_seal_enclave_package_id_here
ENCLAVE_CONFIG_OBJECT_ID=your_enclave_config_object_id_here

# Nautilus Enclave Configuration (GCP Confidential VM / SEV-SNP)
ENCLAVE_URL=http://your-enclave-ip:3000
ENCLAVE_PUBLIC_KEY=your_enclave_public_key_hex_here

# LocalThreatAgent Configuration (to be encrypted with Seal)
AGENT_CONFIG={"scoring_weights":{"intent_mismatch":10.0,"asset_drain":8.0,"permission_change":7.0,"complexity":3.0},"risk_thresholds":{"red_threshold":8.0,"yellow_threshold":4.0},"heuristic_rules":{"max_safe_complexity":5,"suspicious_keywords":["drain","exploit","phishing"]}}

# Sponsor Wallet Private Key (for gasless transactions)
SPONSOR_PRIVATE_KEY=your_sponsor_private_key_base64_here

# Enclave Keypair (generated inside enclave — do not set)
# ENCLAVE_PRIVATE_KEY=

# Cron Job Secret (for Walrus blob lifetime management)
CRON_SECRET=your_secure_cron_secret_here

# Telegram Alerting (optional - add if you have a bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ENOKI_API_KEY=your_enoki_api_key_here
NEXT_PUBLIC_ENOKI_API_KEY=your_enoki_api_key_here
