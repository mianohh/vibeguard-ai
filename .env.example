# ─── Sui smart contracts ────────────────────────────────────────────────────
# Public on-chain addresses — not secrets, but kept as env vars for flexibility
PACKAGE_ID=0xa706a721c2e2684834fd60623ad87ee43be42e241cffb038edd70fb527b494de
REGISTRY_ID=0xf172e861476e122ae699384b95b99591f30b53c5f97f9384e4d1bad5aa6495be
SEAL_ENCLAVE_PACKAGE_ID=0x75f9626ccc7e848c58823924644e5d5167d7231e381fe49734200d81b2419fdc
ENCLAVE_CONFIG_OBJECT_ID=0x2ca9a5fe17b6f53259ccf2c793268a82bd04e3d82fb3bc482a4dbb740400c502

# ─── Nautilus enclave ────────────────────────────────────────────────────────
ENCLAVE_URL=http://<your-enclave-host>:3000
ENCLAVE_PUBLIC_KEY=<hex-encoded-ed25519-public-key>

# ─── Sui network ─────────────────────────────────────────────────────────────
SUI_NETWORK=testnet
# Override only to point at a private fullnode. Public defaults are built-in.
# SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# ─── Sponsor wallet (gasless reporting) ──────────────────────────────────────
SPONSOR_PRIVATE_KEY=<base64-or-suiprivkey-encoded-private-key>

# ─── zkLogin ─────────────────────────────────────────────────────────────────
# Google OAuth client ID — legitimately public (browser-visible by design)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ─── App URL (used by auto-reporter for internal API calls) ──────────────────
APP_URL=https://vibeguardai.xyz

# ─── Redis (background queue for PTB batching) ───────────────────────────────
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Cron (Walrus blob lifetime management) ──────────────────────────────────
CRON_SECRET=<secure-random-string>

# ─── Telegram alerting (optional) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Walrus (optional override) ──────────────────────────────────────────────
# WALRUS_NETWORK=testnet
# WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
